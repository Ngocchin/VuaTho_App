{
  "name": "vuatho-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint config fixtures pages tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && playwright test --config config/playwright.config.ts",
    "test:headed": "playwright test --config config/playwright.config.ts --headed",
    "test:debug": "playwright test --config config/playwright.config.ts --debug",
    "report": "playwright show-report reports/html",
    "install:browsers": "playwright install chromium",
    "android:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/Test-AndroidEnvironment.ps1",
    "android:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/Invoke-AndroidSmoke.ps1",
    "android:test": "wdio run config/wdio.android.conf.ts",
    "android:report": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/New-AndroidReport.ps1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "diff": "8.0.3",
    "mocha": "11.7.5",
    "serialize-javascript": "7.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "@wdio/allure-reporter": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "allure-commandline": "2.46.1",
    "dotenv": "18.0.8",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "webdriverio": "9.32.0"
  }
}
